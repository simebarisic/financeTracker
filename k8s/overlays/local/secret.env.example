# Kopiraj u secret.env i postavi vrijednosti (secret.env je u .gitignore).
# ./scripts/k8s-local.sh up ga sam kreira s nasumičnim vrijednostima.
POSTGRES_PASSWORD=promijeni-me
# min. 32 znaka: openssl rand -hex 48
JWT_SECRET=promijeni-me-na-dugi-nasumicni-string-min-32-znaka
# Lozinka za korisnika "admin" (kreira se pri prvom startu ako nema korisnika)
APP_ADMIN_PASSWORD=promijeni-me
