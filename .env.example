# Copy this file to .env and adjust before running `docker compose up`.
# docker-compose.yml reads these automatically.

# --- Database ---
POSTGRES_DB=financetracker
POSTGRES_USER=financetracker
POSTGRES_PASSWORD=change-this-db-password

# --- Backend / auth ---
# Any random string, at least 32 characters. Generate one with: openssl rand -base64 48
JWT_SECRET=change-this-to-a-long-random-string-at-least-32-characters
JWT_EXPIRATION_MINUTES=1440

# First-run login created automatically if no users exist yet.
# Change the password after first login (Settings page) or before first startup.
APP_ADMIN_USERNAME=admin
APP_ADMIN_PASSWORD=change-this-password

# Origin(s) the frontend is served from, comma separated.
APP_CORS_ALLOWED_ORIGINS=http://localhost:3000

# --- Ports exposed on your machine ---
BACKEND_PORT=8080
FRONTEND_PORT=3000
